# =============================================================================
# EPOXA STEEL — environment variables
# =============================================================================
# Copy to `.env.local` for local development:
#     cp .env.example .env.local
#
# Nothing here is required to run the site. With no variables set at all the
# application builds, serves every page, validates every form and prints the
# emails it would have sent to the server console. Fill these in as you connect
# each service.
# =============================================================================


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph
# images, sitemap.xml and robots.txt. Set this on Railway before going live or
# every canonical URL will point at the default domain.
NEXT_PUBLIC_SITE_URL="https://epoxasteel.com"

# "production" allows search engine indexing. Any other value (or unset on a
# non-production build) serves `Disallow: /` so preview deployments cannot
# outrank the live site.
NEXT_PUBLIC_SITE_ENV="development"


# -----------------------------------------------------------------------------
# Email  (pick ONE provider — Resend is simplest)
# -----------------------------------------------------------------------------
# With neither set, forms still work: submissions are validated, persisted if a
# database is configured, and the email body is printed to the server log.

# --- Option A: Resend (recommended) -------------------------------------------
# https://resend.com → API Keys. Verify epoxasteel.com as a sending domain
# first, or delivery will be rejected.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Option B: SMTP -----------------------------------------------------------
# Works with Google Workspace, Microsoft 365, Namecheap Private Email, etc.
# SMTP_HOST="mail.privateemail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"          # "true" for implicit TLS (port 465)
# SMTP_USER="no-reply@epoxasteel.com"
# SMTP_PASSWORD="your-mailbox-password"

# --- Addresses ----------------------------------------------------------------
# Two generations of names, both read, newer winning. FROM_EMAIL/OWNER_EMAIL/
# REPLY_TO_EMAIL are the current ones; EMAIL_FROM/EMAIL_TO are kept working so a
# deployment already using them does not break on its next redeploy.

# The two that matter. Set both on Railway.

# Envelope sender, for every message the site sends. MUST be a verified Resend
# sender or delivery is refused with `invalid_from_address`. The boot check warns
# when this domain does not match the site's.
FROM_EMAIL="Epoxa Steel <noreply@epoxasteel.com>"

# Where every owner notification goes — contact, quote, newsletter, and the AI
# assistant's lead handoff. Comma-separate for several people.
OWNER_EMAIL="info@epoxasteel.com"

# Where a reply to a *customer-facing* email lands — never the sending address.
# Some people answer their confirmation with the thing they forgot to mention,
# and a reply that bounces off an unattended mailbox is a lost enquiry both sides
# believe was delivered. Defaults to the first OWNER_EMAIL address, so this is
# only worth setting if replies should go somewhere else.
# REPLY_TO_EMAIL="info@epoxasteel.com"

# Reply-To on OWNER notifications is not configurable and never should be: it is
# always the customer's own address, which is what makes pressing Reply work.

# Older aliases. Set either pair, not both.
# EMAIL_FROM="EPOXA STEEL <no-reply@epoxasteel.com>"
# EMAIL_TO="info@epoxasteel.com"

# Points the Resend SDK elsewhere — an enterprise egress proxy, or a local test
# double. Unset in production.
# RESEND_BASE_URL="https://api.resend.com"

# Put the submitter's IP address and full user-agent string in the notification
# you receive. Off by default: an IP is personal data in most jurisdictions this
# site trades in, and that is a decision to make deliberately rather than inherit.
# The privacy policy reads this same variable, so the page always describes what
# the deployment actually does.
# EMAIL_INCLUDE_IP="false"


# -----------------------------------------------------------------------------
# Database  (optional)
# -----------------------------------------------------------------------------
# Postgres connection string. Leave unset and the site runs in email-only mode:
# enquiries are emailed but not stored. Add Postgres in Railway and it injects
# DATABASE_URL automatically; then run `npm run db:push` once to create tables.
# DATABASE_URL="postgresql://user:password@host:5432/epoxa?schema=public"


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Salt for hashing submitter IP addresses before storage. Set to any long random
# string in production — changing it later invalidates existing hashes, which is
# harmless (they are only used for abuse detection).
# IP_HASH_SALT="change-me-to-something-long-and-random"


# -----------------------------------------------------------------------------
# Media  (optional)
# -----------------------------------------------------------------------------
# Serve the hero video from a CDN instead of public/media/hero.mp4. Useful for
# keeping large binaries out of the repository. Must be same-origin or added to
# the `media-src` CSP directive in next.config.ts.
# NEXT_PUBLIC_HERO_VIDEO_URL="https://cdn.example.com/epoxa/hero.mp4"


# -----------------------------------------------------------------------------
# AI assistant  (ships disabled)
# -----------------------------------------------------------------------------
# The assistant is built and complete, and deliberately switched off. The dock
# button still appears; opening it shows an elegant "Coming soon" panel with the
# quote form and the contact page, so nobody who reaches for it leaves empty
# handed. The live transcript UI is not downloaded at all in this state.
#
# To bring it live, all three of these and nothing else:
#     1. OPENAI_API_KEY  — a real key
#     2. AI_ENABLED      — "true"
#     3. Redeploy
#
# Both conditions are required on purpose. A key staged ahead of launch must not
# switch the assistant on, and the flag on with no key would offer to answer and
# then fail — the boot check refuses to start production in that state rather
# than letting it reach a customer. See docs/AI-ASSISTANT.md.
AI_ENABLED="false"

# NOTE: the root layout is statically prerendered, so both of these are read
# when `next build` runs — which is why step 3 is a redeploy. Railway exposes
# service variables to builds, so setting them there is enough. On a platform
# that only injects secrets at runtime, also set NEXT_PUBLIC_ASSISTANT_ENABLED=1
# (below).
# OPENAI_API_KEY="sk-..."

# Model to use. Defaults to gpt-4.1-mini, which is fast and cheap enough to sit
# in front of the whole product catalogue on every message.
# OPENAI_MODEL="gpt-4.1-mini"

# Point at any OpenAI-compatible endpoint — Azure OpenAI, a gateway, a proxy.
# Defaults to https://api.openai.com/v1
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Only needed if your key belongs to several organisations.
# OPENAI_ORG_ID="org-..."

# Forces the live assistant on when the key is not available at build time.
# Safe to expose: it is a boolean, and the API route still refuses to answer
# without a real key on the server.
# NEXT_PUBLIC_ASSISTANT_ENABLED="1"


# -----------------------------------------------------------------------------
# Company details
# -----------------------------------------------------------------------------
# Every business fact on the site reads from here, with the values below as the
# built-in fallbacks. Change a variable and redeploy — no code edit anywhere.
#
# These are NEXT_PUBLIC_ because the footer, the dock and the assistant panel are
# client components, and a variable without that prefix is simply undefined in
# the browser. None of it is a secret; it is all printed on the page already.

# `COMPANY_NAME` is the wordmark — the drawn logotype, all caps, used on the page.
# `COMPANY_LEGAL_NAME` is the brand name every metadata surface uses: titles,
# Open Graph, the manifest, the Apple web-app title and every schema.org node.
# `COMPANY_LEGAL_ENTITY` appears in the copyright line and nowhere else.
# NEXT_PUBLIC_COMPANY_NAME="EPOXA STEEL"
# NEXT_PUBLIC_COMPANY_LEGAL_NAME="Epoxa Steel"
# NEXT_PUBLIC_COMPANY_LEGAL_ENTITY="Epoxa Steel Inc."
# NEXT_PUBLIC_COMPANY_SHORT_NAME="Epoxa"
# NEXT_PUBLIC_COMPANY_TAGLINE="Reinforce Your Dream."
# NEXT_PUBLIC_COMPANY_FOUNDED="2009"
# NEXT_PUBLIC_SITE_DOMAIN="epoxasteel.com"
# NEXT_PUBLIC_SITE_LOCALE="en_US"

# --- Contact ------------------------------------------------------------------
# The tel: link is derived from the display number, so there is only one to keep
# correct. A ten-digit number is treated as North American and dialled as
# +1XXXXXXXXXX, so it works from outside the country; write the number with a
# leading + if it is anywhere else.
# One published address. NEXT_PUBLIC_CONTACT_EMAIL is the only one that needs a
# value — the three below fall back to it, so the quote page, the product pages
# and the job application links all reach the same inbox.
#
# Set one of them only when that mailbox exists and somebody reads it. An address
# that bounces, or that nobody collects, loses the enquiry and the sender's
# belief that it arrived.
# NEXT_PUBLIC_CONTACT_EMAIL="info@epoxasteel.com"
# NEXT_PUBLIC_SALES_EMAIL="sales@epoxasteel.com"
# NEXT_PUBLIC_QUOTES_EMAIL="quotes@epoxasteel.com"
# NEXT_PUBLIC_CAREERS_EMAIL="careers@epoxasteel.com"
# NEXT_PUBLIC_CONTACT_PHONE="(212) 763-8921"

# Opening hours as `Days|Time` pairs separated by semicolons. Add or remove rows
# freely; malformed entries are dropped rather than rendered as debris.
#
# These rows also generate the openingHoursSpecification in the LocalBusiness
# schema, so there is no second copy to keep in step. A day range ("Monday –
# Thursday") is expanded; a row whose time is not a range ("Closed", "By
# appointment") is displayed but left out of the schema, which is exactly right —
# schema.org reads an unlisted day as closed.
#
# Keep the number of rows even if you can: the footer lays them out in two
# columns over a hairline grid, and an odd count leaves one empty cell.
# NEXT_PUBLIC_BUSINESS_HOURS="Monday – Thursday|8:00 AM – 5:00 PM;Friday|8:00 AM – 1:00 PM;Saturday|Closed;Sunday|Closed"

# --- Address ------------------------------------------------------------------
# NEXT_PUBLIC_ADDRESS_LINE1="199 Lee Ave."
# NEXT_PUBLIC_ADDRESS_LINE2="Suite 810"
# NEXT_PUBLIC_ADDRESS_CITY="Brooklyn"
# NEXT_PUBLIC_ADDRESS_REGION="NY"
# NEXT_PUBLIC_ADDRESS_POSTAL_CODE="11211"
# NEXT_PUBLIC_ADDRESS_COUNTRY="United States"
# NEXT_PUBLIC_ADDRESS_COUNTRY_CODE="US"

# Map coordinates for the LocalBusiness schema. Unset by default, and left out of
# the schema entirely rather than guessed at — a latitude that is merely near the
# office puts the pin on somebody else's building, and structured data is taken at
# face value. Without them a search engine geocodes the postal address above.
#
# To set them: open the address in Google Maps, right-click the front door, and
# the first item in the menu is the pair. Both or neither.
# NEXT_PUBLIC_ADDRESS_LATITUDE="00.000000"
# NEXT_PUBLIC_ADDRESS_LONGITUDE="-00.000000"

# --- Social -------------------------------------------------------------------
# All unset, so no social icon appears anywhere on the site and `sameAs` is left
# out of the organisation schema. Set one to a real profile URL and its icon
# returns to the footer and the contact page on the next deploy — no code change.
#
# Leave a variable unset rather than pointing it at a handle the business does not
# own: a link to somebody else's account is worse than no link.
# NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/company/epoxasteel"
# NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/epoxasteel"
# NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/epoxasteel"
# NEXT_PUBLIC_X_URL="https://x.com/epoxasteel"
# NEXT_PUBLIC_YOUTUBE_URL="https://www.youtube.com/@epoxasteel"


# -----------------------------------------------------------------------------
# Forms and uploads
# -----------------------------------------------------------------------------
# Signing key for the short-lived token every form fetches before it can submit —
# the invisible CAPTCHA and the CSRF check in one value. Without it the site falls
# back to a per-process random key, which works but stops tokens validating across
# a restart or a second replica. Any long random string; 32+ characters.
#     openssl rand -hex 32
# FORM_TOKEN_SECRET="change-me-to-something-long-and-random"

# Maximum size per uploaded file, in megabytes. Read at request time, so the limit
# shown beside the file picker is always the one actually enforced. Default 10.
# Up to five files per quote request.
# UPLOAD_MAX_MB="10"

# Where undeliverable email is held until it can be retried. Defaults to
# .email-spool/ inside the app directory — which on Railway is reclaimed on
# redeploy, so mount a volume here if you want the spool to survive one.
# EMAIL_SPOOL_DIR="/data/email-spool"

# IANA zone for the timestamps in owner notifications — your local time, not the
# server's. Defaults to the server's own zone.
# TIMEZONE="America/New_York"


# -----------------------------------------------------------------------------
# Analytics  (nothing is enabled by default)
# -----------------------------------------------------------------------------
# The architecture is in place and entirely dormant. There are no measurement IDs
# anywhere in this repository — set one here and three things happen together:
# the script loads, the Content Security Policy widens by exactly the hosts that
# provider needs, and the cookie notice starts appearing. Nothing is ever loaded
# before a visitor accepts.
#
# Leave all four unset (the shipping default) and the site sets no cookies at
# all, shows no banner, and contacts no third party.
#
# With a Tag Manager container configured, GA is loaded inside it rather than
# separately — two loaders means duplicated pageviews nobody can reconcile.

# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
# NEXT_PUBLIC_META_PIXEL_ID="000000000000000"
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID="0000000"


# -----------------------------------------------------------------------------
# Proxies
# -----------------------------------------------------------------------------
# How many proxies sit in front of the app. `X-Forwarded-For` is appended to by
# each hop, so the trustworthy entry is counted from the RIGHT — the left-most
# entry is whatever the client claimed before any proxy touched it, and trusting
# it makes every rate limit on the site bypassable with a forged header.
#
# Default 1, correct for Railway alone. Behind Cloudflare there are two hops,
# though Cloudflare's `cf-connecting-ip` header is preferred anyway and cannot be
# forged through it, so this rarely needs setting.
# TRUSTED_PROXY_HOPS="1"
