# =============================================================================
# EPOXA STEEL — environment variables
# =============================================================================
# Copy to `.env.local` for local development:
#     cp .env.example .env.local
#
# Nothing here is required to run the site. With no variables set at all the
# application builds, serves every page, validates every form and prints the
# emails it would have sent to the server console. Fill these in as you connect
# each service.
# =============================================================================


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph
# images, sitemap.xml and robots.txt. Set this on Railway before going live or
# every canonical URL will point at the default domain.
NEXT_PUBLIC_SITE_URL="https://epoxasteel.com"

# "production" allows search engine indexing. Any other value (or unset on a
# non-production build) serves `Disallow: /` so preview deployments cannot
# outrank the live site.
NEXT_PUBLIC_SITE_ENV="development"


# -----------------------------------------------------------------------------
# Email  (pick ONE provider — Resend is simplest)
# -----------------------------------------------------------------------------
# With neither set, forms still work: submissions are validated, persisted if a
# database is configured, and the email body is printed to the server log.

# --- Option A: Resend (recommended) -------------------------------------------
# https://resend.com → API Keys. Verify epoxasteel.com as a sending domain
# first, or delivery will be rejected.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Option B: SMTP -----------------------------------------------------------
# Works with Google Workspace, Microsoft 365, Namecheap Private Email, etc.
# SMTP_HOST="mail.privateemail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"          # "true" for implicit TLS (port 465)
# SMTP_USER="no-reply@epoxasteel.com"
# SMTP_PASSWORD="your-mailbox-password"

# --- Addresses (used by both options) -----------------------------------------
# Envelope sender. Must be on a domain you have verified with your provider.
EMAIL_FROM="EPOXA STEEL <no-reply@epoxasteel.com>"

# Where enquiry notifications are delivered. Comma-separate for several people.
EMAIL_TO="info@epoxasteel.com"


# -----------------------------------------------------------------------------
# Database  (optional)
# -----------------------------------------------------------------------------
# Postgres connection string. Leave unset and the site runs in email-only mode:
# enquiries are emailed but not stored. Add Postgres in Railway and it injects
# DATABASE_URL automatically; then run `npm run db:push` once to create tables.
# DATABASE_URL="postgresql://user:password@host:5432/epoxa?schema=public"


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Salt for hashing submitter IP addresses before storage. Set to any long random
# string in production — changing it later invalidates existing hashes, which is
# harmless (they are only used for abuse detection).
# IP_HASH_SALT="change-me-to-something-long-and-random"


# -----------------------------------------------------------------------------
# Media  (optional)
# -----------------------------------------------------------------------------
# Serve the hero video from a CDN instead of public/media/hero.mp4. Useful for
# keeping large binaries out of the repository. Must be same-origin or added to
# the `media-src` CSP directive in next.config.ts.
# NEXT_PUBLIC_HERO_VIDEO_URL="https://cdn.example.com/epoxa/hero.mp4"
